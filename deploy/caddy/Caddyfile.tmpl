{
	admin off
	auto_https off
	# Caddy's own logger (reverse_proxy dial errors, upstream down) records the request URI
	# too, so it gets the same redaction as the site's access log below.
	log {
		format filter {
			request>uri regexp ^/(p|v1/public)/[^/?]+ /${1}/[redacted]
			request>headers>Referer delete
			wrap json
		}
	}
	servers {
		# The FortiGate is the only hop trusted to say who the visitor is (tracker row 71).
		# Its address on the NUC's LAN is the NUC's default gateway.
		trusted_proxies static {{FORTIGATE_LAN_IP}}
		# Cloudflare puts exactly one address, the visitor's, in CF-Connecting-IP. The left
		# end of X-Forwarded-For is whatever the visitor sent, so it is never read.
		# https://developers.cloudflare.com/fundamentals/reference/http-headers/
		client_ip_headers CF-Connecting-IP
	}
}

:80 {
	@diary host perfectday.andrewlass.com
	handle @diary {
		reverse_proxy web:3000 {
			# Exactly one address, the one worked out above; anything the visitor sent is dropped.
			header_up X-Forwarded-For {client_ip}
		}
	}

	@api host perfectday-api.andrewlass.com
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		respond "Not Found" 404
	}

	log {
		output stdout
		format filter {
			request>uri regexp ^/(p|v1/public)/[^/?]+ /${1}/[redacted]
			request>headers>Referer delete
			wrap json
		}
	}
}
